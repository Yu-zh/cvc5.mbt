import {
  "moonbitlang/core/encoding/utf8",
}

import {
  "Yu-zh/cvc5.mbt" @cvc5,
} for "test"

supported_targets = "native"

options(
  "native-stub": [ "cvc5_stub.c" ],
  link: {
    "native": {
      "cc": "cc",
      "stub-cc": "${build.CVC5_CC}",
      "stub-cc-flags": "${build.CVC5_STUB_FLAGS}",
    },
  },
)
